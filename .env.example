# Secrets for the Sermon Scribe edge functions.
#
# Copy to .env, fill in, then push them to Supabase:
#   supabase secrets set --env-file .env
#
# .env is gitignored. Never commit real keys, and never put the secret key or
# the webhook secret anywhere the browser can read them.

# Stripe — test mode keys start sk_test_ / whsec_, live mode sk_live_.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ids from Stripe → Product catalogue. These are prices, not products,
# so they start price_ and not prod_. Test-mode values, CAD:
STRIPE_PRICE_PRO=price_1U5avLJJuJdO8a9khXUTEfL3
STRIPE_PRICE_MINISTRY=price_1U5avLJJuJdO8a9kEkJ2LvxT

# Where Checkout sends people back to.
SITE_URL=https://sermon-scribe.com

# Lock this to the real origin before launch; "*" is for local testing only.
ALLOWED_ORIGIN=*

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into every edge
# function automatically. Do not set them here.
